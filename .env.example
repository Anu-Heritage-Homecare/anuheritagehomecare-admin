# Admin frontend configuration.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle, and those
# values are PUBLIC (baked into the shipped JavaScript). Only put non secret,
# client safe values here. Never put API keys, database URLs or any backend secret
# in a frontend build.
#
# The base URL of the backend API this admin talks to.
VITE_API_URL=https://api.example.com/api/v1
